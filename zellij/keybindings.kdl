// Zellij keys for the tools (zellij 0.42+). Paste the `shared { ... }` block inside the
// `keybinds { ... }` section of ~/.config/zellij/config.kdl. If you don't have a config yet:
//   mkdir -p ~/.config/zellij && zellij setup --dump-config > ~/.config/zellij/config.kdl
// `shared` means the keys work in every mode, locked included. Detach and reattach the session
// (or start a new one) for new bindings to load.
//
//   Alt b   jobs: pick one of your LSF jobs, live card + log tails (bjpick)
//   Alt e   figures in the current project (figs), nearly full screen
//   Alt s   switch to another zellij session (zpick + the zswitch plugin; press y the first time)
// None of these keys is used by zellij's defaults. On a Mac, set your terminal's Option key to act as Alt
// (Ghostty: macos-option-as-alt = true; iTerm2: Profiles > Keys > Left Option = Esc+).
shared {
    bind "Alt b" {
        Run "zbig" "bjpick" {
            floating true
            close_on_exit true
            name "jobs"
        }
    }
    bind "Alt e" {
        Run "zbig" "figs" {
            floating true
            close_on_exit true
            name "figs"
        }
    }
    bind "Alt s" {
        Run "zpick" {
            floating true
            close_on_exit true
            name "sessions"
        }
    }
}
